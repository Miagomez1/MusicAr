@model MusicAr.Web.Models.NuevaPlaylistViewModel
@{
    ViewData["Title"] = "Editar playlist";
}

<div class="d-flex flex-column gap-4">
    <section class="playlist-header d-flex align-items-end gap-4 p-4">
        <div class="cover cover-xl cover-oscuro centrado">@await Html.PartialAsync("_Icono", "nota")</div>
        <div class="flex-grow-1">
            <div class="etiqueta text-white mb-2">PLAYLIST</div>

            <!-- Input conectado para actualizar nombre en blur -->
            <input asp-for="Nombre"
                   class="playlist-nombre form-control bg-transparent text-white border-0 shadow-none fs-3 fw-bold p-0"
                   data-playlist-id="@Model.Id"
                   placeholder="Nombre de la playlist" />

            <div class="small mt-2 text-white-50">Tu usuario · <span id="contador-canciones">0</span> canciones</div>
        </div>
    </section>
</div>

<section class="d-flex flex-column gap-3 mt-4">
    <h2 class="h4 fw-bold mb-0">Busquemos algo para tu playlist</h2>

    <div class="d-flex flex-column gap-1">
        @foreach (var cancion in Model.Sugeridas)
        {
            <div class="fila-simple align-items-center justify-content-between py-2">
                <div class="d-flex align-items-center gap-3">
                    <span class="cover cover-md" style="background-image: @(!string.IsNullOrEmpty(cancion.CoverImageUrl) ? $"url('{cancion.CoverImageUrl}')" : "none"); background-size: cover; background-position: center;"></span>
                    <div>
                        <div class="fw-semibold">@cancion.Titulo</div>
                        <small class="text-body-secondary">@cancion.Artista</small>
                    </div>
                </div>

                <!-- Botón de agregar con el ID real de la playlist y de la canción -->
                <button type="button"
                        class="btn btn-outline-light rounded-pill btn-sm px-3 btn-agregar-playlist"
                        data-playlist-id="@Model.Id"
                        data-cancion-id="@cancion.Id">
                    Agregar
                </button>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        // 1. Guardar nombre automáticamente al perder el foco (blur)
        document.addEventListener('blur', async (e) => {
            const input = e.target.closest('.playlist-nombre');
            if (!input) return;

            const playlistId = input.dataset.playlistId;
            const nuevoNombre = input.value.trim();
            if (!nuevoNombre) return;

            try {
                await fetch(`/api/playlists/${playlistId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ nombre: nuevoNombre })
                });
            } catch (err) {
                console.error("Error al actualizar el nombre:", err);
            }
        }, true);

        // 2. Agregar canción vía AJAX (POST)
        document.addEventListener('click', async (e) => {
            const btn = e.target.closest('.btn-agregar-playlist');
            if (!btn) return;

            e.preventDefault();
            const playlistId = btn.dataset.playlistId;
            const cancionId = btn.dataset.cancionId;

            try {
                const res = await fetch(`/api/playlists/${playlistId}/canciones/${cancionId}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (res.ok) {
                    btn.textContent = "Agregada";
                    btn.classList.remove('btn-outline-light');
                    btn.classList.add('btn-success');
                    btn.disabled = true;
                } else {
                    const err = await res.json().catch(() => ({}));
                    alert(err.mensaje || "Error al agregar la canción.");
                }
            } catch (err) {
                console.warn(err);
                alert("Ocurrió un error de conexión.");
            }
        });
    </script>
}