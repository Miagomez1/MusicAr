@model NuevaPlaylistViewModel
@{
    ViewData["Title"] = "Nueva playlist";
}

<form asp-action="Nueva" method="post" class="d-flex flex-column gap-4">
    <section class="playlist-header d-flex align-items-end gap-4 p-4">
        <div class="cover cover-xl cover-oscuro centrado">@await Html.PartialAsync("_Icono", "nota")</div>
        <div class="flex-grow-1">
            <div class="etiqueta text-white mb-2">PLAYLIST</div>
            <label asp-for="Nombre" class="visually-hidden"></label>
            <input asp-for="Nombre" class="playlist-nombre" />
            <span asp-validation-for="Nombre" class="text-white small d-block"></span>
            @* TODO: mostrar el nombre del usuario logueado y la cantidad real de canciones *@
            <div class="small mt-2">Tu usuario · 0 canciones</div>
        </div>
    </section>

    <div class="d-flex align-items-center gap-3">
        <button type="button" class="btn btn-neutral btn-play btn-play-lg" disabled aria-label="Reproducir">@await Html.PartialAsync("_Icono", "play")</button>
        <button type="submit" class="btn btn-accent rounded-pill px-4">Guardar playlist</button>
    </div>
</form>

<section class="d-flex flex-column gap-3">
    <h2 class="h4 fw-bold mb-0">Busquemos algo para tu playlist</h2>
    <div class="buscador d-flex align-items-center gap-2 px-3" style="max-width: 420px;">
        @await Html.PartialAsync("_Icono", "search")
        <input type="search" class="form-control border-0 bg-transparent shadow-none px-0"
               placeholder="Buscar canciones por título o artista" aria-label="Buscar canciones" />
    </div>

    <div class="d-flex flex-column gap-1">
        @foreach (var cancion in Model.Sugeridas)
        {
            <div class="fila-simple">
                <span class="cover cover-md"></span>
                <div>
                    <div>@cancion.Titulo</div>
                    <small class="text-body-secondary">@cancion.Artista</small>
                </div>
                @* TODO: agregar la canción a la playlist (guarda solo el SongId) *@
                <button type="button" class="btn btn-outline-light rounded-pill btn-sm px-3">Agregar</button>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
