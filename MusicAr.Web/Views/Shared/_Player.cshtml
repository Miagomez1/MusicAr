@* Reproductor mini. Vive en el layout para que la música no se corte al navegar. *@
<footer class="player panel" aria-label="Reproductor">
    <audio id="audio" preload="none"></audio>

    <div class="d-flex align-items-center gap-3">
        <div class="cover cover-lg cover-plum overflow-hidden d-flex align-items-center justify-content-center" id="playerMiniCoverContainer">
            <img id="playerMiniCover" src="" alt="Portada" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
        </div>
        <div>
            <div id="playerMiniTitulo" class="fw-semibold">Sin reproducción</div>
            <small class="text-body-secondary" id="playerMiniArtista">-</small>
        </div>
    </div>

    <div class="d-flex flex-column align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn-icono" id="btnPlayerPrev" aria-label="Anterior">@await Html.PartialAsync("_Icono", "prev")</button>
            <button type="button" class="btn btn-accent btn-play" id="btnPlayerPlay" aria-label="Reproducir">@await Html.PartialAsync("_Icono", "play")</button>
            <button type="button" class="btn-icono" id="btnPlayerNext" aria-label="Siguiente">@await Html.PartialAsync("_Icono", "next")</button>
        </div>
        <div class="progress" id="playerProgressBar" style="cursor: pointer; width: 320px;" role="progressbar" aria-label="Progreso de la canción" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" id="playerProgressFill" style="width: 0%"></div>
        </div>
    </div>

    <button type="button" class="btn btn-outline-light rounded-pill ms-auto"
            data-bs-toggle="modal" data-bs-target="#playerExpandido">
        Abrir reproductor
    </button>
</footer>