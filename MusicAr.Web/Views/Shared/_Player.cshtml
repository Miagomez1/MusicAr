<footer class="player panel" aria-label="Reproductor">
    <audio id="audio" preload="none"></audio>

    <div class="d-flex align-items-center gap-3">
        <!-- Agregamos id="player-cover" y permitimos mostrar imagen de fondo -->
        <div id="player-cover" class="cover cover-lg cover-plum" style="background-size: cover; background-position: center;"></div>
        <div>
            <!-- Agregamos id="player-title" -->
            <div id="player-title" class="fw-bold text-truncate" style="max-width: 180px;">Selecciona una canción</div>
            <!-- Agregamos id="player-artist" -->
            <small id="player-artist" class="text-body-secondary text-truncate" style="max-width: 180px;">-</small>
        </div>
    </div>

    <div class="d-flex flex-column align-items-center gap-2 w-50">
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn-icono" aria-label="Anterior">@await Html.PartialAsync("_Icono", "prev")</button>
            <!-- Agregamos id="btn-play-pause" al botón principal -->
            <button type="button" id="btn-play-pause" class="btn btn-accent btn-play" aria-label="Reproducir/Pausar">@await Html.PartialAsync("_Icono", "play")</button>
            <button type="button" class="btn-icono" aria-label="Siguiente">@await Html.PartialAsync("_Icono", "next")</button>
        </div>

        <!-- Barra de progreso con id="progress-bar-container" y la barrita con id="progress-bar" -->
        <div class="progress w-100" role="progressbar" aria-label="Progreso de la canción" id="progress-bar-container" style="cursor: pointer; height: 6px;">
            <div id="progress-bar" class="progress-bar" style="width: 0%"></div>
        </div>
    </div>

    <button type="button" class="btn btn-outline-light rounded-pill ms-auto"
            data-bs-toggle="modal" data-bs-target="#playerExpandido">
        Abrir reproductor
    </button>
</footer>