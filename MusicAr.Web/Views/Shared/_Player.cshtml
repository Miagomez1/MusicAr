@* Reproductor mini. Vive en el layout para que la música no se corte al navegar. *@
<footer class="player panel" aria-label="Reproductor">
    <audio id="audio" preload="none"></audio>

    <div class="d-flex align-items-center gap-3">
        <div class="cover cover-lg cover-plum"></div>
        <div>
            <div>Canción de ejemplo</div>
            <small class="text-body-secondary">Artista</small>
        </div>
    </div>

    <div class="d-flex flex-column align-items-center gap-2">
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn-icono" aria-label="Anterior">@await Html.PartialAsync("_Icono", "prev")</button>
            <button type="button" class="btn btn-accent btn-play" aria-label="Pausar">@await Html.PartialAsync("_Icono", "play")</button>
            <button type="button" class="btn-icono" aria-label="Siguiente">@await Html.PartialAsync("_Icono", "next")</button>
        </div>
        <div class="progress" role="progressbar" aria-label="Progreso de la canción" aria-valuenow="35" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar" style="width: 35%"></div>
        </div>
    </div>

    <button type="button" class="btn btn-outline-light rounded-pill ms-auto"
            data-bs-toggle="modal" data-bs-target="#playerExpandido">Abrir reproductor</button>
</footer>
