@model MusicAr.Web.Models.BuscadorViewModel
<div class="d-flex align-items-center gap-3">
    <form class="buscador d-flex align-items-center gap-2 flex-grow-1 px-3" 
          role="search" 
          method="get" 
          asp-controller="Buscador" 
          asp-action="Buscar">
        
        @await Html.PartialAsync("_Icono", "search")
        
        <input type="search" 
               asp-for="Q" 
               class="form-control border-0 bg-transparent shadow-none px-0"
               placeholder="¿Qué querés escuchar?" 
               aria-label="Buscador" />
        
        <button type="submit" class="btn p-0 border-0 bg-transparent" aria-label="Buscar">
            <span class="visually-hidden">Buscar</span>
        </button>
    </form>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex align-items-center gap-2">
            <span class="text-white fw-semibold small">@User.Identity.Name</span>
            <a class="btn btn-outline-light rounded-pill px-3 py-1 btn-sm" asp-controller="Cuenta" asp-action="Logout">Cerrar sesión</a>
        </div>
    }
    else
    {
        <a class="btn btn-accent rounded-pill px-4" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
    }
</div>
