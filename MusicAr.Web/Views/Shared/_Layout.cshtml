<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MusicAr</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MusicAr.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell d-flex flex-column vh-100 p-2 gap-2">
        <div class="d-flex flex-grow-1 gap-2 overflow-hidden">
            <partial name="_Sidebar" />
            <main role="main" class="panel contenido flex-grow-1 overflow-auto p-4 d-flex flex-column gap-4">
                <partial name="_TopBar" />
                @RenderBody()
            </main>
        </div>
        <partial name="_Player" />
    </div>
    <partial name="_PlayerExpandido" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
