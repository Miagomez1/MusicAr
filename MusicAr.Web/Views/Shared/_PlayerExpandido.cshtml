@* Reproductor expandido: modal de pantalla completa de Bootstrap (no navega, así la música sigue sonando). *@
<div class="modal fade" id="playerExpandido" tabindex="-1" aria-labelledby="playerExpandidoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content p-2">
            <div class="d-flex gap-2 h-100">

                <section class="panel flex-grow-1 d-flex flex-column p-4">
                    <div class="row align-items-center">
                        <div class="col-4">
                            <button type="button" class="btn btn-outline-light rounded-pill d-inline-flex align-items-center gap-2" data-bs-dismiss="modal">
                                @await Html.PartialAsync("_Icono", "chevron") Cerrar
                            </button>
                        </div>
                        <div class="col-4 text-center">
                            <div class="etiqueta" id="playerExpandidoTitulo">REPRODUCIENDO DESDE</div>
                            <div class="fw-semibold">MusicAr</div>
                        </div>
                    </div>

                    <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center gap-4">
                        <!-- Añadimos id="expanded-cover" -->
                        <div id="expanded-cover" class="cover cover-plum cover-xxl" style="background-size: cover; background-position: center;">
                            @await Html.PartialAsync("_Icono", "nota")
                        </div>

                        <div class="col-reproductor d-flex flex-column gap-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <!-- Añadimos id="expanded-title" -->
                                    <div id="expanded-title" class="fs-4 fw-bold">Canción de ejemplo</div>
                                    <!-- Añadimos id="expanded-artist" -->
                                    <div id="expanded-artist" class="text-body-secondary">Artista</div>
                                </div>
                                <button type="button" class="btn-icono" aria-label="Agregar a favoritos">@await Html.PartialAsync("_Icono", "heart")</button>
                                <button type="button" class="btn-icono" aria-label="Agregar a una playlist">@await Html.PartialAsync("_Icono", "plus")</button>
                            </div>
                            <div>
                                <!-- Añadimos id="expanded-progress-container" y id="expanded-progress-bar" -->
                                <div class="progress" role="progressbar" aria-label="Progreso de la canción" id="expanded-progress-container" style="cursor: pointer; height: 6px;">
                                    <div id="expanded-progress-bar" class="progress-bar" style="width: 0%"></div>
                                </div>
                                <div class="d-flex justify-content-between small text-body-secondary mt-2">
                                    <span id="current-time">0:00</span>
                                    <span id="total-duration">0:00</span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-center align-items-center gap-4">
                                <button type="button" class="btn-icono" aria-label="Anterior">@await Html.PartialAsync("_Icono", "prev")</button>
                                <!-- Añadimos id="expanded-btn-play-pause" -->
                                <button type="button" id="expanded-btn-play-pause" class="btn btn-accent btn-play btn-play-xl" aria-label="Pausar">@await Html.PartialAsync("_Icono", "play")</button>
                                <button type="button" class="btn-icono" aria-label="Siguiente">@await Html.PartialAsync("_Icono", "next")</button>
                            </div>
                        </div>
                    </div>
                </section>

                <aside class="cola panel d-none d-lg-flex flex-column gap-1 p-3 overflow-auto" aria-label="Cola de reproducción">
                    <h2 class="fs-5 px-2 mb-2">Cola de reproducción</h2>
                    <div class="etiqueta px-2">REPRODUCIENDO</div>
                    <div class="cola-item sonando">
                        <span class="cover cover-md cover-oscuro"></span>
                        <div>Canción de ejemplo<br /><small class="text-body-secondary">Artista</small></div>
                    </div>
                    <div class="etiqueta px-2 mt-2">A CONTINUACIÓN</div>
                    @foreach (var c in DatosDemo.Cola())
                    {
                        <div class="cola-item">
                            <span class="cover cover-md"></span>
                            <div>@c.Titulo<br /><small class="text-body-secondary">@c.Artista</small></div>
                        </div>
                    }
                </aside>

            </div>
        </div>
    </div>
</div>