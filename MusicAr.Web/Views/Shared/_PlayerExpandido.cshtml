@* Reproductor expandido: modal de pantalla completa de Bootstrap (no navega, así la música sigue sonando). *@
<div class="modal fade" id="playerExpandido" tabindex="-1" aria-labelledby="playerExpandidoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content p-2">
            <div class="d-flex gap-2 h-100">

                <section class="panel flex-grow-1 d-flex flex-column p-4">
                    <div class="row align-items-center">
                        <div class="col-4">
                            <button type="button" class="btn btn-outline-light rounded-pill d-inline-flex align-items-center gap-2" data-bs-dismiss="modal">
                                @await Html.PartialAsync("_Icono", "chevron") Cerrar
                            </button>
                        </div>
                        <div class="col-4 text-center">
                            <div class="etiqueta" id="playerExpandidoTitulo">REPRODUCIENDO DESDE</div>
                            <div class="fw-semibold" id="playerExpGenero">MusicAr</div>
                        </div>
                    </div>

                    <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center gap-4">
                        <div class="cover cover-plum cover-xxl overflow-hidden d-flex align-items-center justify-content-center" id="playerExpCoverContainer">
                            <img id="playerExpCover" src="" alt="Portada" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                            <span id="playerExpCoverPlaceholder">@await Html.PartialAsync("_Icono", "nota")</span>
                        </div>

                        <div class="col-reproductor d-flex flex-column gap-3">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <div class="fs-4 fw-bold" id="playerExpTitulo">Sin reproducción</div>
                                    <div class="text-body-secondary" id="playerExpArtista">-</div>
                                </div>
                                <button type="button" class="btn-icono" aria-label="Agregar a favoritos">@await Html.PartialAsync("_Icono", "heart")</button>
                                <button type="button" class="btn-icono" aria-label="Agregar a una playlist">@await Html.PartialAsync("_Icono", "plus")</button>
                            </div>
                            <div>
                                <div class="progress" id="playerExpProgressBar" style="cursor: pointer;" role="progressbar" aria-label="Progreso de la canción" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar" id="playerExpProgressFill" style="width: 0%"></div>
                                </div>
                                <div class="d-flex justify-content-between small text-body-secondary mt-2">
                                    <span id="playerExpCurrentTime">0:00</span>
                                    <span id="playerExpTotalTime">0:30</span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-center align-items-center gap-4">
                                <button type="button" class="btn-icono" id="btnExpPrev" aria-label="Anterior">@await Html.PartialAsync("_Icono", "prev")</button>
                                <button type="button" class="btn btn-accent btn-play btn-play-xl" id="btnExpPlay" aria-label="Reproducir">@await Html.PartialAsync("_Icono", "play")</button>
                                <button type="button" class="btn-icono" id="btnExpNext" aria-label="Siguiente">@await Html.PartialAsync("_Icono", "next")</button>
                            </div>
                        </div>
                    </div>
                </section>

                <aside class="cola panel d-none d-lg-flex flex-column gap-1 p-3 overflow-auto" aria-label="Cola de reproducción">
                    <h2 class="fs-5 px-2 mb-2">Cola de reproducción</h2>
                    <div class="etiqueta px-2">REPRODUCIENDO</div>
                    <div class="cola-item sonando">
                        <span class="cover cover-md cover-oscuro"></span>
                        <div><span id="colaActualTitulo">Canción</span><br /><small class="text-body-secondary" id="colaActualArtista">Artista</small></div>
                    </div>
                </aside>

            </div>
        </div>
    </div>
</div>