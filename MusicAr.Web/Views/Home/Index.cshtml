@model IEnumerable<GeneroViewModel>
@{
    ViewData["Title"] = "Inicio";
}

<section>
    <div class="etiqueta">EXPLORAR</div>
    <h1 class="h3 fw-bold mb-0">Géneros</h1>
</section>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
    @foreach (var genero in Model)
    {
        <div class="col">
            <partial name="_GeneroCard" model="genero" />
        </div>
    }
</div>
